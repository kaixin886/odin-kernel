# Re:Kernel (NoActive companion) - in-tree integration for odin 5.4.
# Adapted from Sakion-Team/Re-Kernel Integrate/rekernel/Kconfig.
# Defaults stay n on purpose: scripts/build-kernel.sh enables these
# symbols explicitly for the resukisu variant only, so every other
# variant/config path stays bit-identical to the verified builds.

menu "Re:Kernel"

config REKERNEL
	bool "Re:Kernel support"
	default n
	help
	  Report binder transactions, fatal signals and (optionally)
	  inbound network activity targeting frozen apps to a userspace
	  tombstone daemon (NoActive) over a legacy raw netlink socket
	  (units 22-25, user port 100, discovery via /proc/rekernel).

	  Runtime switch: /sys/kernel/rekernel/enabled (default on).
	  Writing 0 stops all event reporting without a reboot.

config REKERNEL_NETWORK
	bool "Re:Kernel network receive unfreeze support"
	depends on REKERNEL
	default n
	help
	  Report inbound TCP data for uids registered by the daemon
	  (MONITOR_NET legacy command), matching the semantics of the
	  ReKernel 8.0.0_network KPM build.

endmenu
